
name: Build Bazaar Flipper

on:
  workflow_dispatch:
  push:
    paths:
      - 'bazaar-flipper.zip'
      - '.github/workflows/build.yml'

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '25'

      - uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '9.3.0'

      - name: Extract mod source
        run: unzip -q bazaar-flipper.zip -d extracted

      - name: Build mod
        working-directory: extracted/bazaar-flipper
        run: gradle build

      - uses: actions/upload-artifact@v4
        with:
          name: bazaar-flipper-jar
          path: extracted/bazaar-flipper/build/libs/*.jar
